{
  "name": "squiggle",
  "version": "1.0.0",
  "description": "Real-time multiplayer drawing and guessing game",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "npm run dev --prefix client",
    "server": "node server/index.js",
    "install:all": "npm install && npm install --prefix client",
    "build": "npm run build --prefix client",
    "start": "node server/index.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "drawing",
    "multiplayer",
    "game",
    "socket.io",
    "webrtc",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.7.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.2.0",
    "mongoose": "^9.6.3",
    "nanoid": "^5.1.11",
    "socket.io": "^4.8.3"
  }
}
